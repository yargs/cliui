{
  "name": "cliui",
  "version": "9.0.1",
  "description": "easily create complex multi-column command-line-interfaces",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "type": "module",
  "module": "./index.mjs",
  "scripts": {
    "check": "npm run check:lint && npm run check:format",
    "check:format": "prettier --check .",
    "check:lint": "eslint .",
    "fix": "npm run fix:lint && npm run fix:format",
    "fix:format": "prettier --write .",
    "fix:lint": "eslint . --fix",
    "pretest": "rimraf build && tsc -p tsconfig.test.json",
    "test": "c8 mocha ./test/*.mjs",
    "coverage": "c8 report --check-coverage",
    "precompile": "rimraf build",
    "compile": "tsc",
    "prepare": "npm run compile"
  },
  "repository": "yargs/cliui",
  "keywords": [
    "cli",
    "command-line",
    "layout",
    "design",
    "console",
    "wrap",
    "table"
  ],
  "author": "Ben Coe <ben@npmjs.com>",
  "license": "ISC",
  "dependencies": {
    "string-width": "^8.2.2",
    "strip-ansi": "^7.1.0",
    "wrap-ansi": "^10.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chalk": "^5.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.73.0"
  },
  "files": [
    "build",
    "index.mjs",
    "!*.d.ts",
    "!*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=20"
  }
}
